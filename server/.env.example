# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database (Supabase PostgreSQL). Used directly via `pg` (migrations, seed,
# and the app's own queries) rather than the Supabase client SDK, so that
# multi-statement transactions (BEGIN/COMMIT/ROLLBACK) work as the spec
# requires. Use the "Session pooler" connection string from Supabase's
# Database settings (IPv4-safe, supports full session/prepared-statement
# behavior) — not the Transaction pooler, which is reserved for the app's
# serverless runtime in a later phase.
DATABASE_URL=

# Reserved for a later phase (Supabase client SDK use, if ever needed).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin authorization — bcrypt hash, never the plaintext password.
ADMIN_PASSWORD_HASH=
